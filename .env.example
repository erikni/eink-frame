# Samostatný server; HA OS add-on používá interní Supervisor API.
# Výchozí adresa HA. Pokud mDNS nefunguje, použij IP zařízení.
HA_URL=http://homeassistant.local:8123
# Dlouhodobý token vytvořený v uživatelském profilu HA.
HA_TOKEN=replace-with-home-assistant-long-lived-token
# Samostatný náhodný token, stejný jako FRAME_TOKEN ve firmware.
FRAME_TOKEN=replace-with-separate-long-random-token
